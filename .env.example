# Copy to .env and fill in before `docker compose up --build`.
# Every value below has a working default for mock mode (no paid API keys needed).

# --- Postgres ---
POSTGRES_USER=aocc
POSTGRES_PASSWORD=aocc_dev_password
POSTGRES_DB=aocc
# Host port 5432 is often already taken by a local Postgres install; we map to 5433 on the host.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://aocc:aocc_dev_password@postgres:5432/aocc
DATABASE_URL_TEST=postgresql://aocc:aocc_dev_password@localhost:5433/aocc_test

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Ports (host side) ---
GATEWAY_PORT=3001
AI_SERVICE_PORT=8001
FRONTEND_PORT=5173

# --- Auth ---
JWT_SECRET=change_me_dev_secret_please
JWT_EXPIRES_IN=8h
SEED_ADMIN_EMAIL=admin@aocc.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- AI service URL (used by gateway) ---
AI_SERVICE_URL=http://ai-service:8000

# --- LLM / embeddings provider ---
# One of: mock | openai | anthropic
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# --- RAG tuning ---
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_MIN_SIMILARITY=0.2
